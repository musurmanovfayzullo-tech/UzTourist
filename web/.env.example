# Telegram dispatch (SOS + booking alerts). Get a token from @BotFather.
VITE_TELEGRAM_BOT_TOKEN=your_bot_token_here
# Chat/channel ID that receives dispatch alerts.
VITE_TELEGRAM_CHAT_ID=your_chat_id_here
# SHA-256 hex digest of the admin PIN (the PIN itself is never stored).
# Generate: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PIN').digest('hex'))"
VITE_ADMIN_PIN_HASH=your_pin_sha256_hash_here
# Gemini API key for the AR AI guide. Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Dedicated Gemini key for text-to-speech (audio guide narration). Same console.
VITE_GEMINI_TTS_KEY=your_gemini_tts_key_here
